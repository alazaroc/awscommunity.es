---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpainMap from '../../components/SpainMap.astro';
import EventsList from '../../components/EventsList.astro';
import CommunityDayPromo from '../../components/CommunityDayPromo.astro';
import SectionNavigator from '../../components/SectionNavigator.astro';
import ThemeDivider from '../../components/ThemeDivider.astro';
import { communityDay, communityDayEditions } from '../../../config/community-day';
import { userGroups } from '../../../config/user-groups';
import { upcomingGroupIds, freshlyDiscoveredGroupIds } from '../../lib/events';
import { t } from '../../lib/i18n';
import type { EventsSnapshot } from '../../lib/types';
import snapshot from '../../data/events.json';

const groupCount = userGroups.length;
const activeGroupIds = upcomingGroupIds(snapshot as EventsSnapshot);
const freshGroupIds = freshlyDiscoveredGroupIds(snapshot as EventsSnapshot);
---

<BaseLayout locale="en">
  <SectionNavigator locale="en" />
  {communityDay.enabled && communityDay.promotionMode === 'banner' && (
    <>
      <CommunityDayPromo variant="banner" locale="en" />
      <ThemeDivider halloweenOnly />
    </>
  )}

  {communityDay.enabled && communityDay.promotionMode === 'hero' ? (
    <CommunityDayPromo variant="hero" locale="en" />
  ) : (
    <section id="home-hero" data-home-section class="hero" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div>
          <p class="eyebrow">The AWS community in Spain</p>
          <h1 id="hero-title">Learn. Share. <span>Connect.</span></h1>
          <p class="hero-lead">Discover what is happening across Spain’s AWS community and find people to keep learning with.</p>
          <div class="hero-stats" aria-label="Community facts">
            <span>{groupCount} User Groups</span><span>+10,000 members</span>
          </div>
          <div class="hero-actions">
            <a class="button button-primary" href="/en/events">Explore upcoming events</a>
            <a class="button button-secondary" href="/en/user-groups">Find my User Group</a>
          </div>
        </div>
        <div class="hero-visual">
          <SpainMap id="hero-map-en" activeGroupIds={activeGroupIds} freshGroupIds={freshGroupIds} locale="en" />
        </div>
      </div>
    </section>
  )}

  <ThemeDivider />
  <section id="home-upcoming" data-home-section class="section home-section" aria-labelledby="upcoming-title">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">Across the community</p><h2 id="upcoming-title">Upcoming events</h2><p>Meetups, talks and gatherings organised by local communities across Spain.</p></div>
        <a class="text-link" href="/en/events">{t('en', 'viewAllEvents')}</a>
      </div>
      <EventsList limit={3} variant="cards" locale="en" />
    </div>
  </section>

  <ThemeDivider />
  <section id="home-community" data-home-section class="section section-dark home-section" aria-labelledby="groups-title">
    <div class="container community-discovery">
      <div class="community-discovery-content">
        <p class="eyebrow">Close to you</p>
        <h2 id="groups-title">A community distributed across Spain</h2>
        <p class="community-discovery-copy">Connect with professionals, students and curious people who openly share knowledge.</p>
        <div class="city-cloud">
          {userGroups.map((group) => <a href={`/en/user-groups#${group.id}`}>{group.city}</a>)}
        </div>
        <a class="button button-accent" href="/en/user-groups">Explore the {groupCount} User Groups</a>
      </div>
      <aside class="community-network-panel" aria-label={t('en', 'communityNetworkTitle')}>
        <div class="community-network-art" aria-hidden="true">
          <svg viewBox="0 0 420 220" role="presentation">
            <path d="M62 151 128 78l86 71 73-108 72 86" />
            <path d="m62 151 105-17 47 15 73-61" />
            <path d="m128 78 86-7 73 47" />
            <circle cx="62" cy="151" r="8" /><circle cx="128" cy="78" r="8" /><circle cx="214" cy="149" r="11" />
            <circle cx="287" cy="41" r="8" /><circle cx="359" cy="127" r="8" /><circle cx="167" cy="134" r="6" />
          </svg>
        </div>
        <p class="community-network-kicker">{t('en', 'communityNetworkTitle')}</p>
        <p class="community-network-description">{t('en', 'communityNetworkDescription')}</p>
        <div class="community-network-stats">
          <span><strong>{groupCount}</strong>{t('en', 'communityNetworkCities')}</span>
          <span><strong>10k+</strong>{t('en', 'communityNetworkMembers')}</span>
          <span><strong>{activeGroupIds.length}</strong>{t('en', 'communityNetworkEvents')}</span>
        </div>
      </aside>
    </div>
  </section>

  {communityDay.enabled && <CommunityDayPromo variant="block" showEditionLinks locale="en" />}

  <ThemeDivider />
  <section id="home-impact" data-home-section class="section section-soft home-section" aria-labelledby="impact-title">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Collective impact</p><h2 id="impact-title">Built by the community</h2><p>Volunteers creating spaces to learn and connect throughout the year.</p></div></div>
      <div class="impact-grid">
        <article class="impact-card"><strong>{groupCount}</strong><p>AWS User Groups connecting local communities.</p></article>
        <article class="impact-card"><strong>10k+</strong><p>Members sharing experience and knowledge.</p></article>
        <article class="impact-card"><strong>{communityDayEditions.length}</strong><p>AWS Community Day Spain editions since 2023.</p></article>
      </div>
    </div>
  </section>
</BaseLayout>
