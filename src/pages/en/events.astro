---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventsList from '../../components/EventsList.astro';
import RecentEvents from '../../components/RecentEvents.astro';
import YearActivity from '../../components/YearActivity.astro';
import { TIMELINE_MONTHS } from '../../lib/history';
import snapshot from '../../data/events.json';
import type { EventsSnapshot } from '../../lib/types';
import { upcomingEvents } from '../../lib/events';
import { upcomingEventsSchema } from '../../lib/seo';

const schema = upcomingEventsSchema(upcomingEvents(snapshot as EventsSnapshot), 'en', Astro.site ?? new URL(Astro.url.origin));
---

<BaseLayout locale="en" title="Community events" description="Upcoming events and recent activity from AWS User Groups and the AWS community in Spain." schema={schema}>
  <header class="page-header">
    <div class="container">
      <p class="eyebrow">Activity throughout the year</p>
      <h1>Community events</h1>
      <p>A chronological agenda of meetups, talks and gatherings organised by Spain’s AWS User Groups.</p>
    </div>
  </header>
  <section class="section section-soft" style="padding-top:3rem" aria-label="Upcoming events">
    <div class="container">
      <EventsList variant="timeline" locale="en" enableFilters />
    </div>
  </section>

  <section class="section" aria-labelledby="activity-heading">
    <div class="container">
      <YearActivity locale="en" />
    </div>
  </section>

  <section id="recent-events" class="section section-soft" aria-labelledby="timeline-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Last {TIMELINE_MONTHS} months</p>
          <h2 id="timeline-heading">Recent events</h2>
          <p>Each group’s full history is available on its page, starting from <a class="text-link" href="/en/user-groups/">User Groups</a>.</p>
        </div>
      </div>
      <RecentEvents locale="en" />
    </div>
  </section>
</BaseLayout>
