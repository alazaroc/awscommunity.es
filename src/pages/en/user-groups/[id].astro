---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EventsList from '../../../components/EventsList.astro';
import EventHistory from '../../../components/EventHistory.astro';
import { userGroups } from '../../../../config/user-groups';
import { groupDescription, localizedPath } from '../../../lib/i18n';
import type { UserGroup } from '../../../lib/types';

export function getStaticPaths() {
  return userGroups.map((group) => ({ params: { id: group.id }, props: { group } }));
}

interface Props { group: UserGroup; }
const { group } = Astro.props;
const location = group.city === group.region ? group.city : `${group.city}, ${group.region}`;
const description = groupDescription(group.id, 'en', group.description ?? `Local AWS community in ${location}.`);
---

<BaseLayout locale="en" title={group.name} description={`Upcoming events and activity history for ${group.name}.`}>
  <header class="page-header">
    <div class="container">
      <a class="back-link" href={localizedPath('en', `/user-groups/#${group.id}`)}>← All User Groups</a>
      <p class="eyebrow">{group.region}</p>
      <h1>{group.name}</h1>
      <p class="group-page-location">{group.city}</p>
      <p class="group-page-description">{description}</p>
      <div class="group-links">
        <a href={group.website} target="_blank" rel="noopener noreferrer">Official website ↗</a>
        {group.meetupUrl && <a href={group.meetupUrl} target="_blank" rel="noopener noreferrer">Meetup ↗</a>}
        {Object.entries(group.socialLinks ?? {}).map(([network, url]) => <a href={url} target="_blank" rel="noopener noreferrer">{network}</a>)}
      </div>
    </div>
  </header>
  <section class="section section-soft" aria-labelledby="upcoming-heading">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Agenda</p><h2 id="upcoming-heading">Upcoming events</h2></div></div>
      <EventsList groupId={group.id} locale="en" />
    </div>
  </section>
  <section class="section" aria-labelledby="history-heading">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">History</p><h2 id="history-heading">Past events</h2><p>Events that have already taken place, as listed on their public pages. Only verified events are shown.</p></div></div>
      <EventHistory groupId={group.id} locale="en" />
    </div>
  </section>
</BaseLayout>
