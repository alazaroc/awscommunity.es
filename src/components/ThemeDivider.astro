---
interface Props {
  halloweenOnly?: boolean;
}

const { halloweenOnly = false } = Astro.props;
const asset = (file: string) => `${import.meta.env.BASE_URL}halloween/${file}`.replace(/\/{2,}/g, '/');
---
<div class:list={['theme-divider', halloweenOnly && 'theme-divider-halloween-only']} aria-hidden="true">
  <img class="theme-divider-art" data-hw-src={asset('blood-divider.avif')} alt="" width="1376" height="320" loading="lazy" />
  <span class="theme-divider-line"></span>
  <i></i><i></i><i></i><i></i>
</div>

<script is:inline>
  (function () {
    function activate() {
      if (document.documentElement.getAttribute('data-theme') !== 'halloween') return;
      document.querySelectorAll('[data-hw-src]').forEach(function (image) {
        var src = image.getAttribute('data-hw-src');
        if (!src) return;
        image.setAttribute('src', src);
        image.removeAttribute('data-hw-src');
      });
    }

    activate();
    new MutationObserver(activate).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  })();
</script>
