---
import { localizedPath, t, type Locale } from '../lib/i18n';
import { userGroups } from '../../config/user-groups';
import { projectMapCoordinates } from '../lib/map';

interface Props {
  id?: string;
  activeGroupIds?: string[];
  freshGroupIds?: string[];
  showLegend?: boolean;
  locale?: Locale;
}
const {
  id = 'spain-map',
  activeGroupIds = [],
  freshGroupIds = [],
  showLegend = false,
  locale = 'es',
} = Astro.props;
const activeSet = new Set(activeGroupIds);
const freshSet = new Set(freshGroupIds);

const nodes = userGroups.flatMap((group) => {
  if (!group.coordinates) return [];
  return [{ ...group, ...projectMapCoordinates(group.coordinates) }];
});
const nodesById = new Map(nodes.map((node) => [node.id, node]));
const connectionPairs = [
  ['galicia', 'asturias'],
  ['asturias', 'bilbao'],
  ['bilbao', 'zaragoza'],
  ['zaragoza', 'barcelona'],
  ['madrid', 'zaragoza'],
  ['madrid', 'valencia'],
  ['valencia', 'alicante'],
  ['madrid', 'sevilla'],
  ['sevilla', 'malaga'],
  ['valencia', 'palma'],
  ['sevilla', 'las-palmas'],
];
const connections = connectionPairs.flatMap(([fromId, toId]) => {
  const from = nodesById.get(fromId);
  const to = nodesById.get(toId);
  return from && to ? [{ from, to }] : [];
});
const nodeLabel = (node: (typeof nodes)[number]) => {
  const statuses = [
    activeSet.has(node.id) ? t(locale, 'mapUpcoming') : '',
    freshSet.has(node.id) ? t(locale, 'mapFresh') : '',
  ].filter(Boolean);
  const base = t(locale, 'viewGroup', { name: node.name });
  return statuses.length ? `${base} · ${statuses.join(' · ')}` : base;
};
---

<figure class="spain-map" id={id}>
  <svg viewBox="0 0 680 500" role="group" aria-labelledby={`${id}-title ${id}-desc`}>
    <title id={`${id}-title`}>{t(locale, 'mapTitle')}</title>
    <desc id={`${id}-desc`}>{t(locale, 'mapDescription', { count: nodes.length })}</desc>
    <defs>
      <filter id={`${id}-glow`}><feGaussianBlur stdDeviation="5" result="blur" /><feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
    </defs>

