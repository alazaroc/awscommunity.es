      {connections.map(({ from, to }) => <path d={`M${from.x.toFixed(1)} ${from.y.toFixed(1)}L${to.x.toFixed(1)} ${to.y.toFixed(1)}`} />)}
    </g>
    <g class="map-nodes">
      {nodes.map((node) => (
        <a
          class:list={['map-node', { 'has-event': activeSet.has(node.id), 'is-fresh': freshSet.has(node.id) }]}
          href={localizedPath(locale, `/user-groups#${node.id}`)}
          aria-label={nodeLabel(node)}
          data-group-id={node.id}
        >
          <g transform={`translate(${node.x.toFixed(1)} ${node.y.toFixed(1)})`}>
            <circle class="node-hit" r="20" />
            <circle class="fresh-wave" r="10" />
            <circle class="pulse" r="15" />
            <circle class="node-ring" r="10" />
            <circle class="node-dot" r="6" style={`filter:url(#${id}-glow)`} />
            <g class="map-tooltip" aria-hidden="true">
              <rect x="-130" y="-60" width="260" height="44" rx="10" />
              <path d="M-7 -17L0 -9L7 -17Z" />
              <text x="0" y="-33">{node.name}</text>
            </g>
          </g>
        </a>
      ))}
    </g>
  </svg>
  {showLegend && (
    <figcaption class="map-legend">
      <span class="map-legend-title">{t(locale, 'mapSignals')}</span>
      <span class="map-legend-item"><i class="map-legend-dot map-legend-group"></i>{t(locale, 'mapGroup')}</span>
      <span class="map-legend-item"><i class="map-legend-dot map-legend-event"></i>{t(locale, 'mapUpcoming')}</span>
      <span class="map-legend-item"><i class="map-legend-dot map-legend-fresh"></i>{t(locale, 'mapFresh')}</span>
      <span class="map-legend-status" aria-live="polite">
        {freshSet.size > 0
          ? t(locale, freshSet.size === 1 ? 'mapNewSignalOne' : 'mapNewSignalMany', { count: freshSet.size })
          : t(locale, 'mapNoNewSignals')}
      </span>
    </figcaption>
  )}
</figure>

<script>
  import { freshlyDiscoveredGroupIds, upcomingGroupIds } from '../lib/events';
  import type { EventsSnapshot } from '../lib/types';

  const syncMapSignals = (snapshot: EventsSnapshot) => {
    const active = new Set(upcomingGroupIds(snapshot));
    const fresh = new Set(freshlyDiscoveredGroupIds(snapshot));
    for (const node of document.querySelectorAll<SVGAElement>('.map-node[data-group-id]')) {
      const id = node.dataset.groupId ?? '';
      node.classList.toggle('has-event', active.has(id));
      node.classList.toggle('is-fresh', fresh.has(id));
    }
  };

  window.addEventListener('events-snapshot-updated', (event) => {
    const snapshot = (event as CustomEvent<EventsSnapshot>).detail;
    if (snapshot) syncMapSignals(snapshot);
  });
</script>
